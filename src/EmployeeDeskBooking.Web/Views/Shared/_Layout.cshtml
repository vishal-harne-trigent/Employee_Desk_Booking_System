<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Desk Booking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="topnav">
            <img class="brand-logo" src="~/images/desk-booking-logo.png" alt="Desk Booking" />
            <nav aria-label="Main">
                @if (User.IsInRole(EmployeeDeskBooking.Application.Auth.AuthRoles.Employee))
                {
                    <a asp-controller="Book" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "active" : null)">Desk Availability</a>
                    <a asp-controller="MyBookings" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "MyBookings" ? "active" : null)">My Bookings</a>
                }
                @if (User.IsInRole(EmployeeDeskBooking.Application.Auth.AuthRoles.Admin))
                {
                    <a asp-area="Admin" asp-controller="Desks" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "Desks" ? "active" : null)">Desks</a>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : null)">Users</a>
                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "Bookings" ? "active" : null)">All bookings</a>
                }
            </nav>
            <div class="right">
                <span class="user-label">@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="signout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="signout">Sign out</button>
                </form>
            </div>
        </header>
    }

    <main class="main-content" role="main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        &copy; 2026 Desk Booking
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
